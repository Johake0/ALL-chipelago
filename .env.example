# --- Required ---

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
# Two speed-bump passphrases (not real auth) — generate with e.g.
# `openssl rand -hex 32`. Keep them different from each other.
ADMIN_SECRET=
PLAYER_SECRET=
# Comma-separated list of origins allowed to call this API from a browser
# (e.g. your GitHub Pages URL). Falls back to allow-all if unset — fine for
# local dev, set this in production.
ALLOWED_ORIGINS=http://localhost:3000,https://yourname.github.io

# --- Optional ---

PORT=4000

# --- Optional economy tuning ---
# Uncomment any of these to override the default, catalog-calibrated
# values in src/lib/stats.js / src/lib/bonusGame.js. Leave commented to
# keep the defaults shown.

# INVENTORY_SIZE=10
# FREE_INTEREST_PICKS=3
# FREE_REROLLS=5
# REROLL_BASE_COST=500
# REROLL_STEP=150
# STREAK_MULTIPLIER_RATE=0.05
# STREAK_MULTIPLIER_CAP=10
# MILESTONE_INTERVAL=5
# MILESTONE_BASE=200
# MILESTONE_STEP=20
# BONUS_MULTIPLIER=1.5
# BONUS_WEIGHT_RATE=0.5
# BONUS_WEIGHT_CAP=4
# BONUS_REFILL_THRESHOLD=9
# MIN_SESSION_SIZE=2

# --- Optional rate-limit tuning ---
# Requests allowed per IP per window. See src/server.js.

# RATE_LIMIT_WINDOW_MS=300000
# RATE_LIMIT_MAX=300
# AVATAR_RATE_LIMIT_MAX=30
